[worldserver]

########################################
# mod-boss-coins
#
# Tarnished Undermine Reals: coins from dungeon and raid bosses, spent at Pix Xizzix in Booty Bay.
# Which bosses give coins, and how many, is the world table mod_boss_coins_source.
########################################

#
#    BossCoins.Enable
#        Description: Master switch. With 0 no boss gives coins, and nobody gets the daily
#                     login coins. Pix Xizzix, her stock and the coins players already have
#                     are rows in the databases and stay: she keeps trading. Remove those with
#                     the module's uninstall SQL.
#        Default:     1
#

BossCoins.Enable = 1

#
#    BossCoins.MinBossLevel
#        Description: A boss below this level gives no coins when its instance has a row for
#                     the whole map in mod_boss_coins_source. It keeps the first bosses of
#                     Blackrock Depths out. A boss with a row of its own pays whatever its
#                     level. Raid bosses are level 63.
#        Default:     55
#

BossCoins.MinBossLevel = 55

#
#    BossCoins.BossKills.ToWallet
#        Description: Where a boss's coins go. 1: into the account wallet of every real
#                     player in the instance, which the launcher's shop spends from and Pix
#                     Xizzix pays out of; no cap, no bags to fill. 0: into their bags, and by
#                     mail when the bags are full.
#        Default:     1
#

BossCoins.BossKills.ToWallet = 1

#
#    BossCoins.BossKills.BonusAura
#        Description: A spell whose aura gives one more coin per boss award: the aura's first
#                     effect amount is the percent chance. 0 = off. mod-guild-levels' For Great
#                     Justice perk is 90455.
#        Default:     0
#

BossCoins.BossKills.BonusAura = 0

#
#    BossCoins.DailyLogin.Coins
#        Description: Coins an account gets once a day for logging in, after the daily quest
#                     reset. The first character of the account in the world gets them,
#                     including one already in the world when the reset happens. 0 switches
#                     it off.
#        Default:     2
#

BossCoins.DailyLogin.Coins = 2

#
#    BossCoins.DailyLogin.ToWallet
#        Description: Where the daily login coins go. 1: into the account wallet, which the
#                     launcher's shop spends from and Pix Xizzix pays out of. 0: into the bags
#                     of the character that logs in; one that can't hold them all leaves them
#                     for the account's next character.
#        Default:     1
#

BossCoins.DailyLogin.ToWallet = 1

#
#    BossCoins.Shop.Enable
#        Description: The launcher's shop: the .coinshop console commands that the portal calls
#                     over SOAP. With 0 they answer that the shop is closed. The wallet stays:
#                     its coins, the daily login coins and Pix Xizzix's wallet options.
#        Default:     1
#

BossCoins.Shop.Enable = 1

#
#    BossCoins.Shop.AccountWideSpells
#        Description: 1 if mounts and companions are shared by all the characters of an
#                     account on your server (a module that teaches every character what one
#                     knows). Then a shop item that teaches a spell one character knows counts
#                     as owned by every character of the account, and isn't sold again.
#        Default:     0
#

BossCoins.Shop.AccountWideSpells = 0
